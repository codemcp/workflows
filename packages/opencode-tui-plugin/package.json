{
  "name": "@codemcp/workflows-opencode-tui",
  "version": "6.25.0",
  "description": "OpenCode TUI sidebar plugin (OpenCode 1.x and 2.x) that displays the current workflow phase and name",
  "main": "workflows-phase.tsx",
  "exports": {
    "./tui": "./workflows-phase.tsx"
  },
  "files": [
    "workflows-phase.tsx",
    "state-reader.ts"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest --run"
  },
  "peerDependencies": {
    "@codemcp/workflows-core": "*",
    "@opencode-ai/plugin": "*",
    "@opentui/solid": "*",
    "solid-js": "*",
    "@opencode/plugin": "*"
  },
  "devDependencies": {
    "@codemcp/workflows-core": "workspace:*",
    "@opencode-ai/plugin": "*",
    "@opentui/solid": "*",
    "@types/node": "^22.0.0",
    "solid-js": "*",
    "typescript": "^5.9.3",
    "@opencode/plugin": "2.1.2",
    "vitest": "4.0.18"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui-plugin",
    "workflows",
    "responsible-vibe"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemcp/workflows.git",
    "directory": "packages/opencode-tui-plugin"
  },
